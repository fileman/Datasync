<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!--
    This project intentionally does NOT reference TestCommon: TestCommon brings the full
    Microsoft.EntityFrameworkCore.Sqlite package (the unencrypted SQLitePCLRaw.bundle_e_sqlite3 bundle), which would
    conflict with the SQLite3 Multiple Ciphers bundle brought in by the package under test. A project must reference
    exactly one SQLitePCLRaw bundle.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\CommunityToolkit.Datasync.Client.EncryptedSqlite\CommunityToolkit.Datasync.Client.EncryptedSqlite.csproj" />
  </ItemGroup>
</Project>
